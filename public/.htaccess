# Banksia Tours — Apache config for cPanel hosting.
# Upload the contents of dist/ (including this file) to public_html.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Uncomment once SSL is active on the domain to force https://www.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.banksiatours.com.au%{REQUEST_URI} [R=301,L,NE]

  # Old CMS pages (index.php/selectedContent/<id>) → matching new pages.
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/1421035056 [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/1163092997 [NC]
  RewriteRule ^ /about/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/63353039 [NC]
  RewriteRule ^ /terms/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/974690243 [NC]
  RewriteRule ^ /coaches-drivers/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/1918768925 [NC]
  RewriteRule ^ /charters/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/432184977 [NC]
  RewriteRule ^ /charters/#groups [R=301,L,NE]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/904669671 [NC]
  RewriteRule ^ /travel-club/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/1910560607 [NC]
  RewriteRule ^ /camping-safaris/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/1783989715 [NC]
  RewriteRule ^ /group-tours/ [R=301,L]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/2022761914 [NC]
  RewriteRule ^ /coaches-drivers/#express [R=301,L,NE]
  RewriteCond %{REQUEST_URI} ^/index\.php/selectedContent/284480115 [NC]
  RewriteRule ^ /contact/ [R=301,L]

  # Any other old CMS URL → home page.
  RewriteCond %{REQUEST_URI} ^/index\.php [NC]
  RewriteRule ^ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Astro's hashed assets never change, so cache them for a year.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
