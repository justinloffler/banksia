---
import site from '../data/site.json';
import Icon from './Icon.astro';

interface Props {
  heading?: string;
  body?: string;
}

const { business } = site;
const {
  heading = 'Ready to plan your next trip?',
  body = `Call ${business.contactPerson} for dates, quotes and advice — or send us an enquiry and we'll get back to you.`,
} = Astro.props;
---

<section class="cta container" aria-labelledby="cta-heading">
  <div class="band">
    <div class="copy">
      <h2 id="cta-heading">{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="actions">
      <a class="btn btn--primary" href={business.phoneHref}>
        <Icon name="phone" size={18} strokeWidth={2} />
        {business.phone}
      </a>
      <a class="btn btn--light" href="/contact/">Send an enquiry</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--section-y);
  }

  .band {
    display: grid;
    gap: 28px;
    align-items: center;
    padding: clamp(28px, 1rem + 3vw, 56px) clamp(22px, 0.5rem + 3vw, 64px);
    border-radius: var(--radius-panel);
    background: var(--forest);
    color: var(--on-dark);
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  h2 {
    font-size: clamp(1.875rem, 1.3rem + 1.8vw, 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  p {
    max-width: 560px;
    font-size: clamp(16px, 0.95rem + 0.2vw, 18px);
    line-height: 1.6;
    color: var(--on-dark-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .btn--light {
    border-color: var(--on-dark);
    color: var(--on-dark);
  }

  .btn--light:hover {
    background: var(--on-dark);
    color: var(--ink);
  }

  @media (max-width: 599px) {
    .actions .btn {
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .band {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }
  }
</style>
