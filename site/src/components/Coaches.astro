---
import site from '../data/site.json';
import Collage from './Collage.astro';
import Icon from './Icon.astro';
import Snap from './Snap.astro';

interface Props {
  /** Full version for /coaches-drivers/: renders the h1. */
  page?: boolean;
}

const { page = false } = Astro.props;
const { coaches } = site;
const Heading = page ? 'h1' : 'h2';
const [front, interior] = coaches.photos;
---

<section id="coaches" class:list={['section', { 'is-page': page }]} aria-labelledby="coaches-heading">
  <div class="container split">
    <Collage ratio={564 / 540}>
      <Snap {...front} x={0} y={0} w={68} rotate={-2} />
      <Snap {...interior} x={44.3} y={46} w={55} rotate={3} />
    </Collage>

    <div class="stack">
      <p class="eyebrow">{coaches.eyebrow}</p>
      <Heading id="coaches-heading" class="h2">{coaches.heading}</Heading>
      <p class="lead">{coaches.body}</p>
      <ul class="checklist">
        {
          coaches.features.map((feature) => (
            <li>
              <Icon name="check" size={18} strokeWidth={2.2} />
              {feature}
            </li>
          ))
        }
      </ul>
      {
        !page && (
          <>
            <div class="drivers">
              <Icon name="shield" size={28} class="drivers-icon" />
              <p>{coaches.drivers}</p>
            </div>
            <a class="more" href="/coaches-drivers/">
              Meet our coaches &amp; drivers →
            </a>
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  .is-page {
    padding-top: clamp(40px, 1.5rem + 4vw, 96px);
  }

  .is-page :global(h1) {
    font-size: clamp(2.5rem, 1.7rem + 3vw, 4.25rem);
    line-height: 1.04;
  }

  .more {
    font-weight: 600;
  }

  .drivers {
    display: flex;
    gap: 18px;
    padding: 20px 22px;
    border-radius: 16px;
    background: var(--sand);
  }

  .drivers :global(.drivers-icon) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--label-green);
  }

  .drivers p {
    font-size: clamp(15px, 0.9rem + 0.15vw, 16px);
    line-height: 1.6;
    color: #3a4238;
  }
</style>
