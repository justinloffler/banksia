---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import site from '../data/site.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { photo } from '../lib/photos';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Banksia Tours — Coach tours, safaris & charters from Adelaide since 1984',
  description = 'Family-run coach tours from Houghton in the Adelaide Hills since 1984. Day tours, short breaks, 7–21 day holidays, outback camping safaris, group charters and the Banksia Travel Club. Call 08 8380 5588.',
  noindex = false,
} = Astro.props;

const { business } = site;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: photo('coach-uluru.jpg'), format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: business.name,
  url: Astro.site?.href,
  telephone: '+61 8 8380 5588',
  faxNumber: '+61 8 8380 5687',
  foundingDate: String(business.established),
  image: ogImageUrl.href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.suburb,
    addressRegion: business.state,
    postalCode: business.postcode,
    addressCountry: 'AU',
  },
  areaServed: 'Australia',
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6f1e7" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Banksia Tours" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
