---
import site from '../data/site.json';
import Icon from './Icon.astro';

const { tours } = site;
---

<section id="tours" class="section section--paper" aria-labelledby="tours-heading">
  <div class="container stack">
    <div class="intro">
      <div class="stack heading">
        <p class="eyebrow">{tours.eyebrow}</p>
        <h2 id="tours-heading" class="h2">{tours.heading}</h2>
      </div>
      <p class="intro-body">{tours.intro}</p>
    </div>

    <ul class="cards">
      {
        tours.types.map((type) => (
          <li class="card">
            <span class="icon-tile">
              <Icon name={type.icon as 'sun' | 'bed' | 'map' | 'bus'} size={26} />
            </span>
            <h3>{type.title}</h3>
            <p class="meta">{type.meta}</p>
            <p class="body">{type.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="also">
      <Icon name="check" size={24} class="also-icon" />
      <p><strong>Also on offer:</strong> {tours.alsoOnOffer}</p>
      <a href="#contact">Ask about a trip →</a>
    </div>
  </div>
</section>

<style>
  .stack {
    gap: clamp(28px, 1.2rem + 2vw, 48px);
  }

  .heading {
    gap: 14px;
  }

  .intro {
    display: grid;
    gap: 16px;
    align-items: end;
  }

  .intro-body {
    max-width: 440px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .cards {
    display: grid;
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(20px, 1rem + 0.6vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--cream);
  }

  .icon-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--sage-chip);
    color: var(--accent);
  }

  h3 {
    font-size: var(--fs-h3);
  }

  .meta {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .also {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding: 20px 24px;
    border-radius: 16px;
    background: var(--sand);
  }

  .also :global(.also-icon) {
    flex-shrink: 0;
    color: var(--label-green);
  }

  .also p {
    flex: 1 1 320px;
    font-size: clamp(15px, 0.9rem + 0.2vw, 17px);
    line-height: 1.5;
  }

  .also a {
    font-weight: 600;
  }

  @media (min-width: 600px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }
  }

  @media (min-width: 1100px) {
    .cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>
