---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a href="/" class:list={['logo', { compact }]} aria-label="Banksia Tours home">
  <svg class="mark" viewBox="0 0 36 44" fill="none" stroke="#2F4A3A" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <rect x="11" y="3" width="14" height="28" rx="7" fill="var(--accent)" stroke="var(--accent)"></rect>
    <path d="M13 10h10M12 15h12M12 20h12M13 25h10" stroke="#F6F1E7" stroke-width="1.5"></path>
    <path d="M18 31v10"></path>
    <path d="M18 38c-6 0-11-3-13-8 5 0 10 2 13 8zM18 36c5-1 9-4 11-9-5 1-9 4-11 9z"></path>
  </svg>
  <span class="words">
    <span class="name">Banksia Tours</span>
    {!compact && <span class="tag">Coach tours &amp; charters · Est. 1984</span>}
  </span>
</a>

<style>
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
  }

  .mark {
    width: 28px;
    height: 34px;
    flex-shrink: 0;
  }

  .words {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tag {
    display: none;
    margin-top: 5px;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  @media (min-width: 900px) {
    .mark {
      width: 36px;
      height: 44px;
    }

    .name {
      font-size: 26px;
    }
  }

  @media (min-width: 900px) and (max-width: 1199px), (min-width: 1400px) {
    .tag {
      display: block;
    }
  }
</style>
