---
interface Props {
  title: string;
  meta?: string;
  tone?: 'paper' | 'sand';
}

const { title, meta, tone = 'paper' } = Astro.props;
---

<aside class:list={['info', tone]}>
  <h3>{title}</h3>
  {meta && <p class="meta">{meta}</p>}
  <slot />
</aside>

<style>
  .info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(22px, 1rem + 1vw, 32px);
    border: 1px solid var(--line);
    border-radius: 24px;
  }

  .paper {
    background: var(--paper);
  }

  .sand {
    border-color: transparent;
    background: var(--sand);
  }

  h3 {
    font-size: clamp(22px, 1.2rem + 0.5vw, 26px);
  }

  .meta {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .info :global(p:not(.meta)) {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .info :global(ul) {
    display: flex;
    flex-direction: column;
  }

  .info :global(li) {
    padding-block: 10px;
    border-bottom: 1px solid var(--line-soft);
    font-size: 16px;
  }

  .info :global(li:last-child) {
    border-bottom: 0;
  }
</style>
