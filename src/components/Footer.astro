---
import site from '../data/site.json';

const { business } = site;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="columns">
      <div class="brand">
        <span class="name">Banksia Tours</span>
        <p>
          {`Day trips, short breaks, extended holidays, camping safaris and charters from ${business.suburb} in the ${business.region}. Family owned since ${business.established}.`}
        </p>
      </div>

      <nav aria-label="Travel with us">
        <h2>Travel with us</h2>
        <ul>
          <li><a href="/group-tours/">Group tours</a></li>
          <li><a href="/camping-safaris/">Camping &amp; safaris</a></li>
          <li><a href="/charters/">Charters &amp; groups</a></li>
          <li><a href="/travel-club/">Travel Club</a></li>
        </ul>
      </nav>

      <nav aria-label="Company">
        <h2>Company</h2>
        <ul>
          <li><a href="/about/">About us</a></li>
          <li><a href="/coaches-drivers/">Coaches &amp; drivers</a></li>
          <li><a href="/terms/">Terms &amp; conditions</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>

      <div>
        <h2>Get in touch</h2>
        <ul>
          <li><a class="phone" href={business.phoneHref}>{business.phone}</a></li>
          <li class="muted">
            {business.contactPerson}<br />
            {business.suburb} {business.state} {business.postcode}<br />
            Fax {business.fax}
          </li>
          <li class="muted">{business.email}</li>
        </ul>
      </div>
    </div>

    <div class="legal">
      <span>© {year} Banksia Tours. All rights reserved.</span>
      <span>{business.abn}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(44px, 2rem + 3vw, 80px) 32px;
    background: var(--ink);
    color: #e9e3d5;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .brand {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .name {
    font-family: var(--font-display);
    font-size: clamp(26px, 1.4rem + 0.5vw, 30px);
    font-weight: 600;
    color: var(--on-dark);
  }

  .brand p {
    max-width: 340px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--footer-muted);
  }

  h2 {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--footer-label);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
  }

  a {
    color: #e9e3d5;
    text-decoration: none;
  }

  a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .phone {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--on-dark);
  }

  .muted {
    line-height: 1.6;
    color: var(--footer-muted);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(32px, 2rem + 2vw, 56px);
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    font-size: 13px;
    color: var(--footer-label);
  }

  @media (min-width: 900px) {
    .columns {
      grid-template-columns: 2fr 1fr 1fr 1.4fr;
      gap: 48px;
    }

    .brand {
      grid-column: auto;
    }
  }
</style>
